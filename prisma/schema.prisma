// ============================================================================
// BAHRAIN MEDICAL CENTER — Unified Data Model (Prisma + SQLite)
// Spec: docs/spec (bahrain-medical-center-ai-prompt.md §19.1, merged.md §35-A)
// Conventions (ADR-001):
//  • Tables: snake_case plural via @@map. Fields: camelCase (Prisma ergonomics).
//  • Money: Int fils (1 BHD = 1000 fils) — exact decimal, never floats (§17.10).
//  • No DB enums (SQLite-safe): status/type fields are String validated by
//    src/lib/types.ts unions + Zod at the API edge.
//  • Dates: UTC in DB (DateTime), displayed UTC+03:00.
//  • Json fields for structured blobs (ranges, checklists, snapshots).
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ORG / STAFF / HR ───────────────────────────────
model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  addressAr String?
  addressEn String?
  phone     String?
  lat       Float?
  lng       Float?
  hoursAr   String?
  hoursEn   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  departments Department[]
  employees   Employee[]
}

model Department {
  id             String  @id @default(cuid())
  code           String  @unique
  nameAr         String
  nameEn         String
  shortAr        String?
  shortEn        String?
  descAr         String?
  descEn         String?
  color          String  @default("#0d9488")
  icon           String  @default("stethoscope")
  sortOrder      Int     @default(0)
  sensitive      String  @default("standard") // standard|psych|oncology|breast
  onlineBooking  Boolean @default(true)
  publicVisible  Boolean @default(true)
  defaultSlotMin Int     @default(20)
  prepAr         String?
  prepEn         String?
  roomLabel      String?
  branch         Branch? @relation(fields: [branchId], references: [id])
  branchId       String?
  employees      Employee[]
  appointmentTypes AppointmentType[]
  appointments   Appointment[]
}

model Employee {
  id               String       @id @default(cuid())
  staffNo          String       @unique // EMP-0001
  nameAr           String
  nameEn           String
  role             String // reception|nurse|doctor|dentist|surgeon|oncologist|psychiatrist|nutritionist|pediatrician|lab-tech|phlebotomist|radiologist|pharmacist|cashier|insurance|callcenter|collector|inventory|maintenance-tech|maintenance-sup|hr|quality|dpo|auditor|sysadmin|content|center-manager|med-director|dept-head
  jobTitleAr       String
  jobTitleEn       String
  department       Department?  @relation(fields: [departmentId], references: [id])
  departmentId     String?
  branch           Branch?      @relation(fields: [branchId], references: [id])
  branchId         String?
  isDoctor         Boolean      @default(false)
  specialtyAr      String?
  specialtyEn      String?
  credentialsAr    String?
  credentialsEn    String?
  languages        Json? // ["ar","en"]
  photoUrl         String?
  bioAr            String?
  bioEn            String?
  gender           String       @default("male")
  phone            String?
  email            String?
  username         String?      @unique
  active           Boolean      @default(true)
  licenseNo        String?
  licenseAuthority String?
  licenseExpiresAt DateTime?
  privilegedProcs  Json?
  licenseSuspendedAt DateTime?
  consultationMin  Int          @default(20)
  schedule         Json? // weekly template
  onCallZones      Json?
  cvAr             String?
  cvEn             String?
  accentColor      String       @default("#0d9488")
  createdAt        DateTime     @default(now())
  shifts           Shift[]
  leaves           Leave[]
  appointments     Appointment[]
  prescriptionsGiven Prescription[]
}

model Shift {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  date       DateTime
  kind       String // morning|evening|night|oncall
  start      DateTime
  end        DateTime
  note       String?
}

model Leave {
  id          String    @id @default(cuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  type        String // annual|sick|unpaid|training|maternity
  from        DateTime
  to          DateTime
  status      String    @default("requested") // requested|approved|rejected
  reason      String?
  delegateTo  String?
  approvedBy  String?
}

model FacilityLicense {
  id          String    @id @default(cuid())
  kind        String // facility|lab|pharmacy|radiology|defense|insurance
  nameAr      String
  nameEn      String
  authority   String
  number      String
  issuedAt    DateTime
  expiresAt   DateTime
  documentUrl String?
  owner       String?
}

// ─────────────────────────── PATIENTS / MPI ─────────────────────────────────
model Patient {
  id            String        @id @default(cuid())
  mrn           String        @unique // P26-0000123-7
  assurance     Int           @default(3) // 1 chip | 2 visual | 3 self | 4 temp
  firstNameAr   String
  fatherAr      String?
  grandAr       String?
  familyAr      String
  firstNameEn   String?
  familyEn      String?
  latinName     String?
  normalizedKey String? // normalized Arabic search key
  dob           DateTime
  gender        String // male|female
  nationality   String
  motherNameAr  String?
  maritalStatus String?
  occupation    String?
  bloodType     String?
  phone         String?
  altPhone      String?
  email         String?
  preferredLang String        @default("ar")
  contactChannel String        @default("sms")
  address        Json?
  emergency      Json?
  photoUrl       String?
  interpreterNeeded Boolean    @default(false)
  notesAr       String?
  deceased      Boolean       @default(false)
  createdBy      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  identifiers   PatientIdentifier[]
  flags         PatientFlag[]
  policies      InsurancePolicy[]
  appointments        Appointment[]
  encounters          Encounter[]
  orders              Order[]
  specimens           Specimen[]
  labResults          LabResult[]
  criticalAlerts      CriticalAlert[]
  prescriptions       Prescription[]
  invoices            Invoice[]
  payments            Payment[]
  preAuthorizations   PreAuthorization[]
  claims              Claim[]
  consents             Consent[]
  documents            Document[]
  referrals            Referral[]
  tasks                Task[]
  queueTickets         QueueTicket[]
  vitals               Vitals[]
  problems             Problem[]
  allergies            Allergy[]
  medicationStatements MedicationStatement[]
  immunizations        Immunization[]
  growthRecords        GrowthRecord[]
  homeRequests         HomeRequest[]
  messageThreads       MessageThread[]
  mdtCases             MdtCase[]
  imagingStudies     ImagingStudy[]
}

model PatientIdentifier {
  id          String   @id @default(cuid())
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   String
  type        String // CPR|GCC_ID|PASSPORT|TMP
  number      String
  country     String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  source      String   @default("manual") // chip|visual|manual|self
  blindIndex  String   @unique
  note        String?
  createdAt   DateTime @default(now())
}

model InsurancePolicy {
  id          String   @id @default(cuid())
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   String
  payer       PayerCompany @relation(fields: [payerId], references: [id])
  payerId     String
  membershipNo String
  category    String   @default("standard")
  copayFils   Int      @default(0)
  coinsPct    Int      @default(0) // percent 0..100
  ceilingFils Int      @default(0)
  validUntil  DateTime?
  status      String   @default("active")
  cardUrl     String?
}

model PatientFlag {
  id        String   @id @default(cuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  kind      String // allergy|chronic|pregnant|vip|staff-member|minor|disabled|interpreter|debt|legal|restricted
  valueAr   String?
  valueEn   String?
  severity  String   @default("info") // info|warn|critical
}

model PatientRelationship {
  id         String   @id @default(cuid())
  patientId  String
  relatedId  String
  relation   String // guardian|child|spouse|authorized
  verifiedBy String?
  verifiedAt DateTime?
  expiresAt  DateTime?
  note       String?
}

model CareTeamMember {
  id         String   @id @default(cuid())
  patientId  String
  employeeId String
  role       String   @default("treating") // primary|treating|consultant|cover
  from       DateTime @default(now())
  to         DateTime?
  autoFrom   String? // appointment|referral|encounter
}

// ─────────────────────────── APPOINTMENTS / QUEUE ───────────────────────────
model AppointmentType {
  id             String  @id @default(cuid())
  code           String  @unique
  nameAr         String
  nameEn         String
  department     Department? @relation(fields: [departmentId], references: [id])
  departmentId   String?
  durationMin    Int     @default(20)
  priceFils      Int     @default(0)
  priceInsuredFils Int   @default(0)
  requiresReferral Boolean @default(false)
  requiresFasting Boolean @default(false)
  requiresPreAuth  Boolean @default(false)
  isVideo        Boolean @default(false)
  instructionsAr String?
  instructionsEn String?
  followupWindowDays Int @default(14)
  active         Boolean @default(true)
  onlineBookable Boolean @default(true)
  appointments Appointment[]
}

model Appointment {
  id              String   @id @default(cuid())
  code            String   @unique // A-261020-0042 (daily seq)
  patientId       String
  department      Department @relation(fields: [departmentId], references: [id])
  departmentId    String
  employee        Employee? @relation(fields: [employeeId], references: [id])
  employeeId      String?
  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id])
  appointmentTypeId String
  branchId        String?
  start           DateTime
  end             DateTime
  status          String   @default("requested") // requested|confirmed|arrived|in-service|completed|cancelled|no-show|rescheduled
  channel         String   @default("reception") // portal|web|callcenter|reception|doctor|kiosk|referral
  note            String?
  prepAck         Boolean  @default(false)
  priceFils       Int      @default(0)
  paymentStatus   String   @default("unpaid") // unpaid|deposit|paid|insured|package
  cancelReason    String?
  createdBy       String?
  checkinAt       DateTime?
  checkinMethod   String? // barcode|cpr|manual
  createdAt       DateTime @default(now())
  ticket          QueueTicket?
  patient  Patient @relation(fields: [patientId], references: [id])
}

model Waitlist {
  id        String   @id @default(cuid())
  patientId String
  departmentId String?
  employeeId  String?
  windowPref  String?
  status    String   @default("waiting")
  note      String?
  createdAt DateTime @default(now())
}

model ServicePoint {
  id       String @id @default(cuid())
  code     String @unique
  nameAr   String
  nameEn   String
  kind     String // reception|triage|clinic|phlebotomy|lab|radiology|pharmacy|cashier
  branchId String?
  room     String?
  letter   String @default("A")
  active   Boolean @default(true)
  tickets  QueueTicket[]
}

model QueueTicket {
  id             String      @id @default(cuid())
  code           String      @unique // A-042
  patientId      String
  appointmentId  String?  @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  servicePoint   ServicePoint @relation(fields: [servicePointId], references: [id])
  servicePointId String
  priority       String      @default("normal") // emergency|elderly|disabled|pregnant|child|normal
  status         String      @default("waiting") // issued|waiting|called|serving|done|no-show|redirected
  issuedAt       DateTime    @default(now())
  calledAt       DateTime?
  callCount      Int         @default(0)
  roomLabel      String?
  servedAt       DateTime?
  doneAt         DateTime?
  waitedMin      Int         @default(0)
  source         String      @default("reception")
  patient  Patient @relation(fields: [patientId], references: [id])
}

// ─────────────────────────── CLINICAL / EMR ─────────────────────────────────
model Encounter {
  id            String   @id @default(cuid())
  code          String   @unique // V-261020-0187
  patientId     String
  departmentId  String
  doctorId      String?
  appointmentId String?
  type          String   @default("consultation") // consultation|followup|comprehensive|procedure|tele|home
  status        String   @default("scheduled") // scheduled|arrived|triage|awaiting-doctor|in-exam|awaiting-results|exam-done|billing|closed|cancelled|no-show|left-early
  chief         String?
  hpi           String?
  exam          String?
  assessment    String?
  plan          String?
  instructionsAr String?
  instructionsEn String?
  soap          Json? // {s,o,a,p} bilingual optional
  heightCm      Float?
  weightKg      Float?
  startedAt     DateTime @default(now())
  closedAt      DateTime?
  signedAt      DateTime?
  followUpAt    DateTime?
  addendum      Json?
  createdAt     DateTime @default(now())
  patient  Patient @relation(fields: [patientId], references: [id])
}

model Vitals {
  id         String   @id @default(cuid())
  patientId  String
  encounterId String?
  recordedBy String?
  tempC      Float?
  pulse      Int?
  resp       Int?
  bpSys      Int?
  bpDia      Int?
  spo2       Int?
  weightKg   Float?
  heightCm   Float?
  waistCm    Float?
  bmi        Float?
  recordedAt DateTime @default(now())
  note       String?
  patient  Patient @relation(fields: [patientId], references: [id])
}

model Problem {
  id        String   @id @default(cuid())
  patientId String
  encounterId String?
  icd10     String
  nameAr    String
  nameEn    String
  status    String   @default("active") // active|resolved
  onset     DateTime?
  resolvedAt DateTime?
  notedBy   String?
  createdAt DateTime @default(now())
  patient  Patient @relation(fields: [patientId], references: [id])
}

model Allergy {
  id        String   @id @default(cuid())
  patientId String
  substance String
  reaction  String?
  severity  String   @default("moderate")
  notedBy   String?
  patient  Patient @relation(fields: [patientId], references: [id])
}

model MedicationStatement {
  id        String   @id @default(cuid())
  patientId String
  drugId    String?
  nameAr    String
  nameEn    String
  dose      String?
  status    String   @default("active") // active|stopped
  source    String   @default("reported")
  stoppedAt DateTime?
  patient  Patient @relation(fields: [patientId], references: [id])
}

model Immunization {
  id          String   @id @default(cuid())
  patientId   String
  vaccine     String
  vaccineEn   String?
  doseLabel   String
  givenAt     DateTime
  batch       String?
  site        String?
  givenBy     String?
  nextDueAt   DateTime?
  certCode    String?
  patient  Patient @relation(fields: [patientId], references: [id])
}

model GrowthRecord {
  id         String   @id @default(cuid())
  patientId  String
  metric     String // weight|height|head|bmi
  value      Float
  ageMonths  Int
  z          Float?
  percentile Float?
  flag       String?
  recordedAt DateTime @default(now())
  patient  Patient @relation(fields: [patientId], references: [id])
}

// ─────────────────────────── LAB / ORDERS ───────────────────────────────────
model LabTest {
  id          String  @id @default(cuid())
  code        String  @unique
  loinc       String?
  nameAr      String
  nameEn      String
  category    String  @default("general")
  sampleType  String  @default("serum")
  tube        String  @default("SST")
  fasting     Boolean @default(false)
  tatHours    Int     @default(24)
  priceFils   Int     @default(0)
  unit        String
  refRange    Json? // {male:{low,high}, female:{low,high}, child:{...}, pregnant:{...}}
  critical    Json? // {low, high}
  autoVerify  Boolean @default(true)
  deltaPct    Int     @default(50)
  reflexTo    Json?
  calcRule    String? // LDL | eGFR
  selfOrder   Boolean @default(false)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  results      LabResult[]
}

model ImagingType {
  id        String  @id @default(cuid())
  code      String  @unique
  nameAr    String
  nameEn    String
  modality  String  @default("US") // US|DXR|MG|MRI|CT
  prepAr    String?
  prepEn    String?
  priceFils Int     @default(0)
  pregnancyCheck Boolean @default(true)
  doseMgy   Float?
  durationMin Int   @default(20)
  template  String? // tirads|birads|general|abdomen|renal|dental
  active    Boolean @default(true)
}

model Order {
  id          String   @id @default(cuid())
  code        String   @unique // O-261020-0512
  patientId   String
  encounterId String?
  doctorId    String?
  kind        String   @default("lab") // lab|imaging|procedure|nutrition
  priority    String   @default("routine") // routine|urgent|stat
  status      String   @default("draft") // draft|signed|received|in-progress|completed|reported|cancelled|rejected
  reason      String?
  fasting     Boolean  @default(false)
  preAuthId   String?
  paymentStatus String @default("unpaid")
  priceFils   Int      @default(0)
  createdAt   DateTime @default(now())
  signedAt    DateTime?
  items       OrderItem[]
  patient  Patient @relation(fields: [patientId], references: [id])
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String
  labTestId   String?
  imagingTypeId String?
  nameAr      String
  nameEn      String
  qty         Int      @default(1)
  priceFils   Int      @default(0)
  status      String   @default("ordered") // ordered|collected|in-progress|resulted|verified|released|cancelled
  results      LabResult[]
}

model Specimen {
  id          String   @id @default(cuid())
  code        String   @unique // S-261020-0231
  orderId     String
  patientId   String
  collectedAt DateTime?
  collectedBy String?
  tube        String   @default("SST")
  status      String   @default("pending") // pending|drawn|in-transit|received|analyzing|analyzed|stored|destroyed|rejected
  rejection   String?
  tempC       Float?
  receivedAt  DateTime?
  receivedBy  String?
  handedAt    DateTime? // chain of custody
  chain       Json?
  patient  Patient @relation(fields: [patientId], references: [id])
}

model LabResult {
  id          String   @id @default(cuid())
  orderItemId String
  patientId   String
  testId      String
  value       Float?
  valueText   String?
  unit        String
  flag        String? // normal|H|L|CRIT
  refLow      Float?
  refHigh     Float?
  resultedAt  DateTime @default(now())
  source      String   @default("manual") // analyzer|manual|poc
  resultedBy  String?
  verifiedAt  DateTime?
  verifiedBy  String?
  autoVerified Boolean @default(false)
  deltaPct    Float?
  prevValue   Float?
  releasedAt  DateTime?
  releasedBy  String?
  comment     String?
  criticalAlert CriticalAlert?
  patient  Patient @relation(fields: [patientId], references: [id])
  orderItem  OrderItem @relation(fields: [orderItemId], references: [id])
  test       LabTest   @relation(fields: [testId], references: [id])
}

model CriticalAlert {
  id           String   @id @default(cuid())
  result       LabResult @relation(fields: [resultId], references: [id])
  resultId     String @unique
  patientId    String
  status       String   @default("new") // new|acknowledged|escalated-1|escalated-2
  notifiedAt   DateTime @default(now())
  channel      String   @default("inapp") // inapp|sms|phone
  ackBy        String?
  ackAt        DateTime?
  log          Json?
  patient  Patient @relation(fields: [patientId], references: [id])
}

model QcRun {
  id        String   @id @default(cuid())
  testId    String?
  assetId   String?
  runAt     DateTime @default(now())
  level     Int      @default(1)
  target    Float
  observed  Float
  status    String   @default("passed") // passed|failed|warned
  rule      String?  // 1-3s|2-2s|R-4s ...
  lotNo     String?
}

model ImagingStudy {
  id          String   @id @default(cuid())
  code        String   @unique
  patientId   String
  typeId      String
  orderItemId String?
  status      String   @default("scheduled") // scheduled|in-progress|captured|report-draft|reported|signed|cancelled
  performedAt DateTime?
  performedBy String?
  images      Json? // synthetic seeds + captions
  studyUid    String?
  dose        Float?
  findingsAr  String?
  reportAr    String?
  reportEn    String?
  template    String?
  grade       String? // TI-RADS 3 | BI-RADS 4a ...
  signedBy    String?
  signedAt    DateTime?
  createdAt   DateTime @default(now())
  patient  Patient @relation(fields: [patientId], references: [id])
}

// ─────────────────────────── PHARMACY ───────────────────────────────────────
model Drug {
  id            String  @id @default(cuid())
  code          String  @unique
  atc           String?
  nameAr        String
  nameEn        String
  generic       String?
  form          String  @default("tablet")
  strength      String?
  priceFils     Int     @default(0)
  mgPerKg       Float?
  maxMgPerKg    Float?
  maxDailyMg    Int?
  adultMaxDose  String?
  pregCategory  String  @default("B")
  controlled    Boolean @default(false)
  refrigerated  Boolean @default(false)
  stockQty      Int     @default(0)
  parLevel      Int     @default(10)
  allergyTags   Json? // penicillin|nsaid ...
  interactTags  Json?
  lookAlike     String?
  highAlert     Boolean @default(false)
  active        Boolean @default(true)
  prescriptionItems PrescriptionItem[]
}

model Prescription {
  id         String   @id @default(cuid())
  code       String   @unique // RX-261020-0093
  patientId  String
  encounterId String?
  doctorId   String?
  status     String   @default("draft") // draft|signed|pharmacy-review|preparing|dispensed|partial|cancelled
  signedAt   DateTime?
  safety     Json? // {errors:[],warnings:[]}
  overrideReason String?
  createdAt  DateTime @default(now())
  items      PrescriptionItem[]
  patient  Patient @relation(fields: [patientId], references: [id])
  doctor   Employee? @relation(fields: [doctorId], references: [id])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  prescriptionId String
  drugId         String
  doseAr         String
  doseEn         String
  route          String       @default("oral")
  frequency       String
  durationDays    Int          @default(5)
  qty            Int          @default(1)
  refills        Int          @default(0)
  instrAr        String?
  instrEn        String?
  drug  Drug @relation(fields: [drugId], references: [id])
  dispensings   Dispensing[]
}

model Dispensing {
  id            String   @id @default(cuid())
  prescriptionItemId String
  batchId       String?
  qty           Int      @default(1)
  status        String   @default("ready") // ready|dispensed|partial|returned
  dispensedBy   String?
  dispensedAt   DateTime?
  labelAr       String?
  labelEn       String?
  counseled     Boolean  @default(false)
  paymentStatus String   @default("unpaid")
  deliveredVia  String?
  prescriptionItem  PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
}

// ─────────────────────────── BILLING / INSURANCE ────────────────────────────
model PayerCompany {
  id        String  @id @default(cuid())
  code      String  @unique
  nameAr    String
  nameEn    String
  kind      String  @default("insurance") // insurance|corporate
  contact   String?
  phone     String?
  contractRef String?
  coverage  Json? // exclusions, waiting periods, preauth required services
  creditLimitFils Int @default(0)
  active    Boolean @default(true)
  policies  InsurancePolicy[]
}

model ServiceItem {
  id        String  @id @default(cuid())
  code      String  @unique
  nameAr    String
  nameEn    String
  departmentId String?
  category  String  @default("consultation") // consultation|lab|imaging|dental|procedure|package-item|drug|consent|home
  priceFils Int     @default(0)
  vatRate   Int     @default(0) // 0|500 (‰ style: 5% = 50? no — store basis points of percent: 5% => 500)
  durationMin Int   @default(20)
  prepAr    String?
  prepEn    String?
  online    Boolean @default(true)
  visible   Boolean @default(true)
  glCode    String?
  sortOrder Int     @default(0)
}

model Package {
  id        String  @id @default(cuid())
  code      String  @unique
  nameAr    String
  nameEn    String
  items     Json? // [{serviceCode, qty}]
  priceFils Int     @default(0)
  validityDays Int  @default(365)
  sessions  Int     @default(1)
